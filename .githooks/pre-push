#!/bin/sh
# Inspect every commit reachable from each pushed ref, not only the current tree.
# This also prevents an old clone from restoring unpublished research history.
set -eu
objects=$(mktemp -t wonjun-public-history)
trap 'rm -f "$objects"' EXIT HUP INT TERM
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  git rev-list --objects "$local_oid" > "$objects"
  if LC_ALL=C grep -E ' (cvpr27(/|$)|private(/|$)|papers/2434_When_Fine_Tuning_Drifts_M\.pdf$)' "$objects" >/dev/null; then
    echo "Push blocked: unpublished research is present in this ref's history." >&2
    echo "Use the cleaned canonical repository; do not merge old history into it." >&2
    exit 1
  fi
done
